<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/nav_separator"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/nav_separator"
        android:layout_width="match_parent"
        android:layout_height="0.8dp"
        android:background="@color/border_subtle"
        app:layout_constraintBottom_toTopOf="@id/nav_view" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/nav_view"
        style="@style/IosBottomNavStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/bg_dark"
        app:itemActiveIndicatorStyle="@style/IosNavNoIndicator"
        app:itemIconTint="@color/ios_nav_item_tint"
        app:itemTextColor="@color/ios_nav_item_tint"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>